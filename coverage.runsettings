<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
	<DataCollectors>
	  <DataCollector friendlyName="XPlat Code Coverage">
		<Configuration>
		  <Format>cobertura</Format>
		  <Include>[CodeRacer.Server]*</Include>
		  <Exclude>[CodeRacer.Server]CodeRacer.Server.Migrations.*</Exclude>
		  <ExcludeByFile>**/Migrations/*.cs,**/*.Designer.cs</ExcludeByFile>
		  <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
		  <Threshold>50</Threshold>
		  <ThresholdType>line</ThresholdType>
		  <ThresholdStat>total</ThresholdStat>
		</Configuration>
	  </DataCollector>
	</DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
